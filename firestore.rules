      && data.coinBonusPerUsd is number && data.coinBonusPerUsd >= 0
      && data.claimedUsd is number && data.claimedUsd >= 0
      && data.claimedCoins is number && data.claimedCoins >= 0
      && data.startedAtMs is number && data.startedAtMs > 0
      && data.lastClaimAtMs is number && data.lastClaimAtMs >= data.startedAtMs
      && data.status in ['active', 'completed']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidCoinTapAccount(data, userId) {
      return data.keys().hasAll([
        'uid', 'totalTappedCoins', 'unclaimedTapCoins', 'dailyTappedCoins',
        'lastTapDayKey', 'totalClaimedUsdFromTap', 'totalClaimedCoins',
        'energy', 'lastEnergySyncMs', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'totalTappedCoins', 'unclaimedTapCoins', 'dailyTappedCoins',
        'lastTapDayKey', 'totalClaimedUsdFromTap', 'totalClaimedCoins',
        'energy', 'lastEnergySyncMs', 'updatedAt'
      ])
      && isValidId(data.uid) && data.uid == userId
      && data.totalTappedCoins is number && data.totalTappedCoins >= 0
      && data.unclaimedTapCoins is number && data.unclaimedTapCoins >= 0
      && data.dailyTappedCoins is number && data.dailyTappedCoins >= 0
      && isNonEmptyString(data.lastTapDayKey, 16)
      && data.totalClaimedUsdFromTap is number && data.totalClaimedUsdFromTap >= 0
      && data.totalClaimedCoins is number && data.totalClaimedCoins >= 0
      && data.energy is number && data.energy >= 0
      && data.lastEnergySyncMs is number && data.lastEnergySyncMs > 0
      && data.updatedAt == request.time;
    }

    function isValidReferralStat(data, handleId) {
      return data.keys().hasAll(['handle', 'clicks', 'lastClickedAt', 'updatedAt'])
      && data.keys().hasOnly(['handle', 'clicks', 'lastClickedAt', 'updatedAt'])
      && isValidId(data.handle) && data.handle == handleId && data.handle.size() <= 32
      && data.clicks is number && data.clicks >= 1 && data.clicks <= 10000000
      && data.lastClickedAt == request.time
      && data.updatedAt == request.time;
    }

    function isValidForexTrade(data) {
      return data.keys().hasAll([
        'uid', 'userName', 'symbol', 'direction', 'accountTierId', 'accountTierName',
        'lots', 'leverage', 'entryPrice', 'closePrice', 'slPrice', 'tpPrice',
        'marginUsd', 'commissionUsd', 'realizedPnlUsd', 'status',
        'openedAtMs', 'closedAtMs', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'userName', 'symbol', 'direction', 'accountTierId', 'accountTierName',
        'lots', 'leverage', 'entryPrice', 'closePrice', 'slPrice', 'tpPrice',
        'marginUsd', 'commissionUsd', 'realizedPnlUsd', 'status',
        'openedAtMs', 'closedAtMs', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && isNonEmptyString(data.userName, 120)
      && isNonEmptyString(data.symbol, 16)
      && data.direction in ['BUY', 'SELL']
      && data.accountTierId in ['standard', 'pro', 'raw_spread']
      && isNonEmptyString(data.accountTierName, 40)
      && data.lots is number && data.lots >= 0.01 && data.lots <= 100
      && data.leverage is number && data.leverage >= 1 && data.leverage <= 1000
      && data.entryPrice is number && data.entryPrice > 0
      && data.closePrice is number && data.closePrice >= 0
      && data.slPrice is number && data.slPrice >= 0
      && data.tpPrice is number && data.tpPrice >= 0
      && data.marginUsd is number && data.marginUsd > 0 && data.marginUsd <= 10000000
      && data.commissionUsd is number && data.commissionUsd >= 0 && data.commissionUsd <= 100000
      && data.realizedPnlUsd is number
      && data.status in ['open', 'closed']
      && data.openedAtMs is number && data.openedAtMs > 0
      && data.closedAtMs is number && data.closedAtMs >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidCopyTradeSubscription(data) {
      return data.keys().hasAll([
        'uid', 'userName', 'traderId', 'traderName', 'traderHandle', 'accountTierId',
        'allocatedUsd', 'riskMultiplier', 'stopLossPercent', 'performanceFeePercent',
        'dailyTargetPercent', 'claimedProfitUsd', 'startedAtMs', 'lastSyncedAtMs',
        'status', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'userName', 'traderId', 'traderName', 'traderHandle', 'accountTierId',
        'allocatedUsd', 'riskMultiplier', 'stopLossPercent', 'performanceFeePercent',
        'dailyTargetPercent', 'claimedProfitUsd', 'startedAtMs', 'lastSyncedAtMs',
        'status', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && isNonEmptyString(data.userName, 120)
      && isValidId(data.traderId) && data.traderId.size() <= 64
      && isNonEmptyString(data.traderName, 80)
      && isNonEmptyString(data.traderHandle, 32)
      && data.accountTierId in ['standard', 'pro', 'raw_spread']
      && data.allocatedUsd is number && data.allocatedUsd >= 1 && data.allocatedUsd <= 10000000
      && data.riskMultiplier is number && data.riskMultiplier >= 0.25 && data.riskMultiplier <= 5
      && data.stopLossPercent is number && data.stopLossPercent >= 5 && data.stopLossPercent <= 95
      && data.performanceFeePercent is number && data.performanceFeePercent >= 0 && data.performanceFeePercent <= 50
      && data.dailyTargetPercent is number && data.dailyTargetPercent >= 0 && data.dailyTargetPercent <= 50
      && data.claimedProfitUsd is number && data.claimedProfitUsd >= 0
      && data.startedAtMs is number && data.startedAtMs > 0
      && data.lastSyncedAtMs is number && data.lastSyncedAtMs >= data.startedAtMs
      && data.status in ['active', 'stopped']
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidAdminActionLog(data) {
      return data.keys().hasAll([
        'adminUid', 'adminEmail', 'action', 'targetUid', 'targetLabel',
        'details', 'amountUsd', 'createdAt'
      ]) && data.keys().hasOnly([
        'adminUid', 'adminEmail', 'action', 'targetUid', 'targetLabel',
        'details', 'amountUsd', 'createdAt'
      ])
      && isValidId(data.adminUid) && data.adminUid == request.auth.uid
      && isNonEmptyString(data.adminEmail, 254)
      && isNonEmptyString(data.action, 80)
      && isBoundedString(data.targetUid, 128)
      && isNonEmptyString(data.targetLabel, 160)
      && isNonEmptyString(data.details, 500)
      && data.amountUsd is number
      && data.createdAt == request.time;
    }

    function isValidSupportChatThread(data, userId) {
      return data.keys().hasAll([
        'uid', 'userName', 'userEmail', 'userHandle', 'status',
        'lastMessage', 'lastSender', 'unreadByAdmin', 'unreadByClient',
        'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'userName', 'userEmail', 'userHandle', 'status',
        'lastMessage', 'lastSender', 'unreadByAdmin', 'unreadByClient',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid) && data.uid == userId
      && isNonEmptyString(data.userName, 120)
      && isNonEmptyString(data.userEmail, 254)
      && isNonEmptyString(data.userHandle, 32)
      && data.status in ['open', 'resolved']
      && isBoundedString(data.lastMessage, 500)
      && data.lastSender in ['client', 'admin']
      && data.unreadByAdmin is number && data.unreadByAdmin >= 0 && data.unreadByAdmin <= 10000
      && data.unreadByClient is number && data.unreadByClient >= 0 && data.unreadByClient <= 10000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidSupportChatMessage(data, userId) {
      return data.keys().hasAll([
        'uid', 'senderUid', 'senderRole', 'senderName', 'text', 'topicTag', 'createdAt'
      ]) && data.keys().hasOnly([
        'uid', 'senderUid', 'senderRole', 'senderName', 'text', 'topicTag', 'createdAt'
      ])
      && isValidId(data.uid) && data.uid == userId
      && isValidId(data.senderUid) && data.senderUid == request.auth.uid
      && data.senderRole in ['client', 'admin']
      && isNonEmptyString(data.senderName, 120)
      && isNonEmptyString(data.text, 2000)
      && isBoundedString(data.topicTag, 80)
      && data.createdAt == request.time;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll([
        'uid', 'userName', 'userEmail', 'userHandle', 'ticketNumber',
        'category', 'priority', 'subject', 'description', 'referenceId',
        'status', 'adminReply', 'resolvedBy', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'userName', 'userEmail', 'userHandle', 'ticketNumber',
        'category', 'priority', 'subject', 'description', 'referenceId',
        'status', 'adminReply', 'resolvedBy', 'autoAckMessage', 'estimatedResponseTime',
        'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid)
      && isNonEmptyString(data.userName, 120)
      && isNonEmptyString(data.userEmail, 254)
      && isNonEmptyString(data.userHandle, 32)
      && isNonEmptyString(data.ticketNumber, 32)
      && data.category in ['deposit', 'withdrawal', 'kyc', 'trading', 'forex', 'p2p', 'account', 'other']
      && data.priority in ['low', 'medium', 'high', 'urgent']
      && data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 140
      && data.description is string && data.description.size() >= 5 && data.description.size() <= 2500
      && isBoundedString(data.referenceId, 120)
      && data.status in ['open', 'in_progress', 'resolved', 'closed']
      && isBoundedString(data.adminReply, 2000)
      && isBoundedString(data.resolvedBy, 120)
      && (!('autoAckMessage' in data) || isBoundedString(data.autoAckMessage, 2000))
      && (!('estimatedResponseTime' in data) || isBoundedString(data.estimatedResponseTime, 80))
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidUserNotification(data, userId) {
      return data.keys().hasAll([
        'uid', 'type', 'ticketId', 'ticketNumber', 'recipientEmail',
        'senderName', 'title', 'emailSubject', 'message', 'category',
        'priority', 'estimatedResponseTime', 'read', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'type', 'ticketId', 'ticketNumber', 'recipientEmail',
        'senderName', 'title', 'emailSubject', 'message', 'category',
        'priority', 'estimatedResponseTime', 'read', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid) && data.uid == userId
      && data.type in ['ticket_received', 'ticket_status_update', 'support_reply']
      && isValidId(data.ticketId)
      && isNonEmptyString(data.ticketNumber, 32)
      && isNonEmptyString(data.recipientEmail, 254)
      && isNonEmptyString(data.senderName, 120)
      && isNonEmptyString(data.title, 160)
      && isNonEmptyString(data.emailSubject, 200)
      && data.message is string && data.message.size() >= 5 && data.message.size() <= 2500
      && isBoundedString(data.category, 40)
      && isBoundedString(data.priority, 20)
      && isBoundedString(data.estimatedResponseTime, 80)
      && data.read is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    match /test/connection {
      allow get: if true;
    }

    match /config/{docId} {
      allow get: if isValidId(docId);
      allow create, update: if isValidId(docId) && isAdmin() && isValidPlatformConfig(incoming());
      allow delete: if false;
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(userId) && isAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().role == 'user'
        && incoming().kycStatus in ['unsubmitted', 'pending']
        && incoming().usdBalance == 0
        && incoming().profitBalance == 0
        && incoming().totalInvested == 0
        && incoming().totalWithdrawn == 0
        && incoming().isMentor == false
        && incoming().mentorGiftedCapital == 0
        && incoming().mentorRequiredVolume == 0
        && incoming().mentorBroughtVolume == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().kycStatus == 'pending'
            && (!('kycApiVerificationStatus' in incoming()) || incoming().kycApiVerificationStatus in ['none', 'ocr_preview_only', 'manual_review'])
            && (!('kycRejectionReason' in incoming()) || incoming().kycRejectionReason == '')
            && (!('kycResubmissionRequested' in incoming()) || incoming().kycResubmissionRequested == false)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'fullName', 'idType', 'idNumber', 'idPhotoData', 'idBackPhotoData', 'portraitPhotoData',
              'kycStatus', 'kycCountryCode', 'kycCountryName', 'kycDateOfBirth', 'kycNationality',
              'kycIssueDate', 'kycExpiryDate', 'kycAddress', 'kycRejectionReason',
              'kycResubmissionRequested', 'kycVerificationMethod', 'kycApiVerificationStatus',
              'kycOcrConfidence', 'kycLivenessPassed', 'kycSubmittedAtMs', 'updatedAt'
            ])
          )
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().kycStatus == existing().kycStatus
            && incoming().usdBalance == existing().usdBalance
            && incoming().profitBalance == existing().profitBalance
            && incoming().totalInvested == existing().totalInvested
            && incoming().totalWithdrawn == existing().totalWithdrawn
            && incoming().isMentor == existing().isMentor
            && incoming().mentorGiftedCapital == existing().mentorGiftedCapital
            && incoming().mentorRequiredVolume == existing().mentorRequiredVolume
            && incoming().mentorBroughtVolume == existing().mentorBroughtVolume
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'avatarData', 'email', 'fullName',
              'countryCode', 'countryName', 'phoneDialPrefix', 'phoneNumber', 'phoneVerified',
              'whitelistStrictMode', 'whitelist24hLockEnabled',
              'updatedAt'
            ])
          )
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().kycStatus == existing().kycStatus
            && incoming().isMentor == existing().isMentor
            && incoming().mentorGiftedCapital == existing().mentorGiftedCapital
            && incoming().mentorRequiredVolume == existing().mentorRequiredVolume
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'usdBalance', 'profitBalance', 'totalInvested', 'totalWithdrawn', 'updatedAt'
            ])
          )
          || (
            incoming().role == existing().role
            && incoming().kycStatus == existing().kycStatus
            && incoming().usdBalance >= existing().usdBalance
            && incoming().profitBalance >= existing().profitBalance
            && incoming().mentorBroughtVolume >= existing().mentorBroughtVolume
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'usdBalance', 'profitBalance', 'mentorBroughtVolume', 'updatedAt'
            ])
          )
        );
      allow delete: if false;

      match /paymentMethods/{methodDocId} {
        allow get: if isValidId(userId) && isValidId(methodDocId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isValidId(userId)
          && isValidId(methodDocId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPaymentMethod(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(methodDocId)
          && isVerifiedUser()
          && (isOwner(userId) || isAdmin())
          && isValidUserPaymentMethod(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'label', 'methodId', 'methodName', 'accountAddress', 'accountHolder', 'isDefault', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(methodDocId) && isVerifiedUser() && (isOwner(userId) || isAdmin());
      }

      match /whitelistedWallets/{walletId} {
        allow get: if isValidId(userId) && isValidId(walletId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isValidId(userId)
          && isValidId(walletId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidWhitelistedWallet(incoming(), userId)
          && incoming().verifiedViaOtp == true
          && incoming().createdAt == request.time
          && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);
        allow update: if isValidId(userId)
          && isValidId(walletId)
          && isVerifiedUser()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidWhitelistedWallet(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().createdAtMs == existing().createdAtMs
          && incoming().verifiedViaOtp == true
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'label', 'network', 'address', 'verifiedViaOtp',
            'lockDelayHours', 'unlockAtMs', 'updatedAtMs', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(walletId) && isVerifiedUser() && (isOwner(userId) || isAdmin());
      }

      match /loginActivities/{activityId} {
        allow get: if isValidId(userId) && isValidId(activityId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isValidId(userId)
          && isValidId(activityId)
          && isSignedIn()
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidLoginActivity(incoming(), userId);
        allow update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isValidId(userId)
          && isValidId(notificationId)
          && isSignedIn()
          && isValidUserNotification(incoming(), userId)
          && incoming().read == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            isAdmin()
            || (
              isOwner(userId)
              && incoming().type == 'ticket_received'
              && existsAfter(/databases/$(database)/documents/supportTickets/$(incoming().ticketId))
              && getAfter(/databases/$(database)/documents/supportTickets/$(incoming().ticketId)).data.uid == request.auth.uid
            )
          );
        allow update: if isValidId(userId)
          && isValidId(notificationId)
          && isSignedIn()
          && (isOwner(userId) || isAdmin())
          && isValidUserNotification(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().type == existing().type
          && incoming().ticketId == existing().ticketId
          && incoming().ticketNumber == existing().ticketNumber
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            || (
              isOwner(userId)
              && incoming().read == true
              && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
            )
          );
        allow delete: if false;
      }
    }

    match /handles/{handle} {
      allow get: if isValidId(handle) && isSignedIn();
      allow list: if isAdmin();
      allow create: if isValidId(handle) && isVerifiedUser() && isValidPublicHandle(incoming(), handle);
      allow update, delete: if isAdmin();
    }

    match /emailHashes/{emailHash} {
      allow get: if isValidId(emailHash) && isSignedIn();
      allow list: if false;
      allow create: if isValidId(emailHash) && isVerifiedUser() && isValidEmailLookup(incoming());
      allow update, delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow get: if isValidId(referralId) && isSignedIn() && (
        existing().referrerUid == request.auth.uid ||
        existing().refereeUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.referrerUid == request.auth.uid ||
        resource.data.refereeUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(referralId)
        && isVerifiedUser()
        && isValidReferralLink(incoming())
        && (incoming().refereeUid == request.auth.uid || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(referralId)
        && isVerifiedUser()
        && isValidReferralLink(incoming())
        && incoming().referrerUid == existing().referrerUid
        && incoming().refereeUid == existing().refereeUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().refereeUid == request.auth.uid &&
            incoming().totalInvestedUsd >= existing().totalInvestedUsd &&
            incoming().diff(existing()).affectedKeys().hasOnly(['totalInvestedUsd', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /referralStats/{handle} {
      allow get: if isValidId(handle);
      allow list: if isAdmin();
      allow create: if isValidId(handle)
        && isValidReferralStat(incoming(), handle)
        && incoming().clicks == 1;
      allow update: if isValidId(handle)
        && isValidReferralStat(incoming(), handle)
        && incoming().handle == existing().handle
        && incoming().clicks == existing().clicks + 1;
      allow delete: if false;
    }

    match /marketingCardStats/{docId} {
      allow get: if isValidId(docId) && isSignedIn();
      allow list: if isAdmin();
      allow create: if docId == 'global'
        && isSignedIn()
        && isValidMarketingCardStats(incoming())
        && incoming().totalGenerated <= 1
        && incoming().totalShared <= 1;
      allow update: if docId == 'global'
        && isSignedIn()
        && isValidMarketingCardStats(incoming())
        && (
          (incoming().totalGenerated == existing().totalGenerated + 1 && incoming().totalShared == existing().totalShared) ||
          (incoming().totalShared == existing().totalShared + 1 && incoming().totalGenerated == existing().totalGenerated)
        );
      allow delete: if false;
    }

    match /investments/{investmentId} {
      allow get: if isValidId(investmentId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(investmentId)
        && isVerifiedUser()
        && isValidInvestment(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            incoming().uid == request.auth.uid &&
            incoming().isMentorGifted == false &&
            incoming().claimedProfit == 0 &&
            incoming().status == 'active'
          )
        );
      allow update: if isValidId(investmentId)
        && isVerifiedUser()
        && isValidInvestment(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().uid == request.auth.uid &&
            existing().status != 'capital_withdrawn' &&
            incoming().claimedProfit >= existing().claimedProfit &&
            incoming().diff(existing()).affectedKeys().hasOnly(['claimedProfit', 'status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /cryptoDeposits/{depositId} {
      allow get: if isValidId(depositId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(depositId)
        && isVerifiedUser()
        && isValidCryptoDeposit(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().status == 'pending' && incoming().adminNote == '')
          || (
            incoming().status == 'approved'
            && ('verificationSource' in incoming())
            && incoming().verificationSource == 'web3_auto'
            && ('web3TxKey' in incoming())
            && existsAfter(/databases/$(database)/documents/web3VerifiedTxs/$(incoming().web3TxKey))
          )
        );
      allow update: if isValidId(depositId)
        && isAdmin()
        && isValidCryptoDeposit(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status == 'pending'
        && incoming().status in ['approved', 'rejected']
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow get: if isValidId(withdrawalId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(withdrawalId)
        && isVerifiedUser()
        && isValidWithdrawal(incoming())
        && incoming().uid == request.auth.uid
        && incoming().adminNote == ''
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(withdrawalId)
        && isAdmin()
        && isValidWithdrawal(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().status == 'pending'
            && incoming().status in ['approved', 'rejected']
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'adminNote', 'payoutTxHash', 'reviewedByUid', 'reviewedByEmail', 'updatedAt'
            ])
          )
          || (
            incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'adminNote', 'payoutTxHash', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /p2pTransfers/{transferId} {
      allow get: if isValidId(transferId) && isSignedIn() && (
        existing().senderUid == request.auth.uid ||
        existing().receiverUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(transferId)
        && isVerifiedUser()
        && isValidP2PTransfer(incoming());
      allow update, delete: if false;
    }

    match /walletTransfers/{transferId} {
      allow get: if isValidId(transferId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(transferId)
        && isVerifiedUser()
        && isValidWalletTransfer(incoming())
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update, delete: if false;
    }

    match /mlmCommissions/{commissionId} {
      allow get: if isValidId(commissionId) && isSignedIn() && (
        existing().beneficiaryUid == request.auth.uid ||
        existing().fromUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.beneficiaryUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(commissionId)
        && isVerifiedUser()
        && isValidMlmCommission(incoming())
        && (incoming().fromUid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /memeCoinInvestments/{allocationId} {
      allow get: if isValidId(allocationId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(allocationId)
        && isVerifiedUser()
        && isValidMemeCoinInvestment(incoming());
      allow update, delete: if false;
    }

    match /coinMiningStakes/{stakeId} {
      allow get: if isValidId(stakeId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(stakeId)
        && isVerifiedUser()
        && isValidCoinMiningStake(incoming())
        && incoming().uid == request.auth.uid
        && incoming().claimedUsd == 0
        && incoming().claimedCoins == 0
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(stakeId)
        && isVerifiedUser()
        && isValidCoinMiningStake(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().uid == request.auth.uid &&
            existing().status == 'active' &&
            incoming().claimedUsd >= existing().claimedUsd &&
            incoming().claimedCoins >= existing().claimedCoins &&
            incoming().lastClaimAtMs >= existing().lastClaimAtMs &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'claimedUsd', 'claimedCoins', 'lastClaimAtMs', 'status', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /coinTapAccounts/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidCoinTapAccount(incoming(), userId)
        && incoming().totalClaimedUsdFromTap == 0
        && incoming().totalClaimedCoins == 0;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && (isOwner(userId) || isAdmin())
        && isValidCoinTapAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && (
          isAdmin() || (
            incoming().totalTappedCoins >= existing().totalTappedCoins &&
            incoming().totalClaimedUsdFromTap >= existing().totalClaimedUsdFromTap &&
            incoming().totalClaimedCoins >= existing().totalClaimedCoins &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'totalTappedCoins', 'unclaimedTapCoins', 'dailyTappedCoins',
              'lastTapDayKey', 'totalClaimedUsdFromTap', 'totalClaimedCoins',
              'energy', 'lastEnergySyncMs', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /forexTrades/{tradeId} {
      allow get: if isValidId(tradeId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(tradeId)
        && isVerifiedUser()
        && isValidForexTrade(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'open'
        && incoming().closePrice == 0
        && incoming().realizedPnlUsd == 0
        && incoming().closedAtMs == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(tradeId)
        && isVerifiedUser()
        && isValidForexTrade(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().uid == request.auth.uid &&
            existing().status == 'open' &&
            incoming().status == 'closed' &&
            incoming().closedAtMs >= existing().openedAtMs &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'closePrice', 'realizedPnlUsd', 'status', 'closedAtMs', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /copyTradeSubscriptions/{subId} {
      allow get: if isValidId(subId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(subId)
        && isVerifiedUser()
        && isValidCopyTradeSubscription(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'active'
        && incoming().claimedProfitUsd == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(subId)
        && isVerifiedUser()
        && isValidCopyTradeSubscription(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().uid == request.auth.uid &&
            existing().status == 'active' &&
            incoming().claimedProfitUsd >= existing().claimedProfitUsd &&
            incoming().lastSyncedAtMs >= existing().lastSyncedAtMs &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'claimedProfitUsd', 'lastSyncedAtMs', 'status', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /adminLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAdminActionLog(incoming());
      allow update, delete: if false;
    }

    match /supportChats/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isSignedIn()
        && (isOwner(userId) || isAdmin())
        && isValidSupportChatThread(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isSignedIn()
        && isValidSupportChatThread(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().lastSender == 'client'
            && incoming().status == 'open'
            && incoming().unreadByAdmin >= existing().unreadByAdmin
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessage', 'lastSender', 'status', 'unreadByAdmin', 'unreadByClient', 'updatedAt'
            ])
          )
          || (
            isOwner(userId)
            && incoming().unreadByClient == 0
            && incoming().diff(existing()).affectedKeys().hasOnly(['unreadByClient', 'updatedAt'])
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isValidId(userId) && isValidId(messageId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isValidId(userId)
          && isValidId(messageId)
          && isSignedIn()
          && (isOwner(userId) || isAdmin())
          && isValidSupportChatMessage(incoming(), userId)
          && (
            (isAdmin() && incoming().senderRole == 'admin')
            || (isOwner(userId) && incoming().senderRole == 'client')
          );
        allow update, delete: if false;
      }
    }

    match /supportTickets/{ticketId} {
      allow get: if isValidId(ticketId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(ticketId)
        && isSignedIn()
        && isValidSupportTicket(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'open'
        && incoming().adminReply == ''
        && incoming().resolvedBy == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(ticketId)
        && isAdmin()
        && isValidSupportTicket(incoming())
        && incoming().uid == existing().uid
        && incoming().ticketNumber == existing().ticketNumber
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /web3VerifiedTxs/{txKey} {
      allow get: if isValidId(txKey) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(txKey)
        && isVerifiedUser()
        && isValidWeb3VerifiedTx(incoming(), txKey);
      allow update, delete: if false;
    }

    match /walletTransactions/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(txId)
        && isVerifiedUser()
        && isValidWalletTransaction(incoming())
        && (incoming().uid == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isSignedIn() && (existing().actorUid == request.auth.uid || existing().targetUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.actorUid == request.auth.uid || resource.data.targetUid == request.auth.uid || isAdmin());
      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidSecurityAuditLog(incoming())
        && (
          isAdmin()
          || (
            incoming().actorUid == request.auth.uid
            && incoming().actorRole in ['user', 'system_web3_verifier']
          )
        );
      allow update, delete: if false;
    }

    match /userMissions/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId))
        && isValidUserMissionProfile(incoming(), userId);
      allow delete: if false;
    }

    match /adminSecrets/{docId} {
      allow get: if isValidId(docId) && docId in ['emailConfig', 'telegramConfig'] && isAdmin();
      allow list: if false;
      allow create, update: if isValidId(docId)
        && isAdmin()
        && (
          (docId == 'emailConfig' && isValidAdminEmailSecretConfig(incoming()))
          || (docId == 'telegramConfig' && isValidAdminTelegramSecretConfig(incoming()))
        );
      allow delete: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Security Primitives
    // =========================================================================

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'shakiljr323@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isBoundedString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================

    function isValidPlatformConfig(data) {
      return data.keys().hasAll([
        'companyName', 'companyTagline', 'companyDescription', 'companyGoal',
        'riskDisclosure', 'trustpilotScore', 'trustpilotReviews', 'nortonScore',
        'isoScore', 'certikScore', 'minWithdrawalUsd', 'eliteCapitalLockDays',
        'totalProfitDays', 'globalPaused', 'packages', 'mlmRates',
        'depositWallets', 'pumpFunToken', 'updatedAt'
      ]) && data.keys().hasOnly([
        'companyName', 'companyTagline', 'companyDescription', 'companyGoal',
        'riskDisclosure', 'trustpilotScore', 'trustpilotReviews', 'nortonScore',
        'isoScore', 'certikScore', 'minWithdrawalUsd', 'eliteCapitalLockDays',
        'totalProfitDays', 'globalPaused', 'depositsPaused', 'withdrawalsPaused', 'signupsPaused', 'p2pPaused',
        'moduleControls', 'supportLinks', 'packages', 'mlmRates', 'mentorConfig',
        'depositWallets', 'paymentMethods', 'pumpFunToken', 'dashboardAnnouncement',
        'bannerAds', 'coinMiningSettings', 'coinMiningPlans', 'forexConfig',
        'supportAutoResponder', 'kycSettings', 'marketingCardsConfig', 'howItWorksConfig',
        'leaderboardConfig', 'web3PaymentConfig', 'updatedAt'
      ])
      && isNonEmptyString(data.companyName, 120)
      && isBoundedString(data.companyTagline, 200)
      && isBoundedString(data.companyDescription, 1500)
      && isBoundedString(data.companyGoal, 1500)
      && isBoundedString(data.riskDisclosure, 1500)
      && data.trustpilotScore is number && data.trustpilotScore >= 0 && data.trustpilotScore <= 5
      && data.trustpilotReviews is number && data.trustpilotReviews >= 0
      && data.nortonScore is number && data.nortonScore >= 0 && data.nortonScore <= 5
      && data.isoScore is number && data.isoScore >= 0 && data.isoScore <= 5
      && data.certikScore is number && data.certikScore >= 0 && data.certikScore <= 5
      && data.minWithdrawalUsd is number && data.minWithdrawalUsd >= 1
      && data.eliteCapitalLockDays is number && data.eliteCapitalLockDays >= 1
      && data.totalProfitDays is number && data.totalProfitDays >= 1
      && data.globalPaused is bool
      && (!('depositsPaused' in data) || data.depositsPaused is bool)
      && (!('withdrawalsPaused' in data) || data.withdrawalsPaused is bool)
      && (!('signupsPaused' in data) || data.signupsPaused is bool)
      && (!('p2pPaused' in data) || data.p2pPaused is bool)
      && (!('moduleControls' in data) || (
        data.moduleControls is map &&
        data.moduleControls.keys().hasAll([
          'aiTradingEnabled', 'forexMarketEnabled', 'coinMiningEnabled',
          'p2pEnabled', 'requireSignupForTradingModules'
        ]) &&
        data.moduleControls.keys().hasOnly([
          'aiTradingEnabled', 'forexMarketEnabled', 'coinMiningEnabled',
          'p2pEnabled', 'requireSignupForTradingModules'
        ]) &&
        data.moduleControls.aiTradingEnabled is bool &&
        data.moduleControls.forexMarketEnabled is bool &&
        data.moduleControls.coinMiningEnabled is bool &&
        data.moduleControls.p2pEnabled is bool &&
        data.moduleControls.requireSignupForTradingModules is bool
      ))
      && (!('supportLinks' in data) || (
        data.supportLinks is map &&
        data.supportLinks.keys().hasAll(['telegramUrl', 'whatsappUrl', 'supportEmail']) &&
        data.supportLinks.keys().hasOnly(['telegramUrl', 'whatsappUrl', 'supportEmail']) &&
        isBoundedString(data.supportLinks.telegramUrl, 250) &&
        isBoundedString(data.supportLinks.whatsappUrl, 250) &&
        isBoundedString(data.supportLinks.supportEmail, 254)
      ))
      && data.packages is list && data.packages.size() >= 1 && data.packages.size() <= 25
      && data.packages[0] is map
      && data.mlmRates is map
      && (!('mentorConfig' in data) || (
        data.mentorConfig is map &&
        data.mentorConfig.keys().hasAll([
          'enabled', 'mentorCommissionPercent', 'volumeMultiplier',
          'defaultGiftCapital', 'defaultDailyPercent'
        ]) &&
        data.mentorConfig.keys().hasOnly([
          'enabled', 'mentorCommissionPercent', 'volumeMultiplier',
          'defaultGiftCapital', 'defaultDailyPercent'
        ]) &&
        data.mentorConfig.enabled is bool &&
        data.mentorConfig.mentorCommissionPercent is number &&
        data.mentorConfig.mentorCommissionPercent >= 0 &&
        data.mentorConfig.mentorCommissionPercent <= 50 &&
        data.mentorConfig.volumeMultiplier is number &&
        data.mentorConfig.volumeMultiplier >= 1 &&
        data.mentorConfig.volumeMultiplier <= 20 &&
        data.mentorConfig.defaultGiftCapital is number &&
        data.mentorConfig.defaultGiftCapital >= 1 &&
        data.mentorConfig.defaultDailyPercent is number &&
        data.mentorConfig.defaultDailyPercent >= 0.1 &&
        data.mentorConfig.defaultDailyPercent <= 50
      ))
      && data.depositWallets is map
      && (!('paymentMethods' in data) || (
        data.paymentMethods is list &&
        data.paymentMethods.size() >= 1 &&
        data.paymentMethods.size() <= 25 &&
        data.paymentMethods[0] is map
      ))
      && (!('dashboardAnnouncement' in data) || (
        data.dashboardAnnouncement is map &&
        data.dashboardAnnouncement.keys().hasAll(['enabled', 'tone', 'title', 'message']) &&
        data.dashboardAnnouncement.keys().hasOnly(['enabled', 'tone', 'title', 'message', 'updatedBy']) &&
        data.dashboardAnnouncement.enabled is bool &&
        data.dashboardAnnouncement.tone in ['info', 'warning', 'urgent', 'success'] &&
        isBoundedString(data.dashboardAnnouncement.title, 120) &&
        isBoundedString(data.dashboardAnnouncement.message, 500) &&
        (!('updatedBy' in data.dashboardAnnouncement) || isBoundedString(data.dashboardAnnouncement.updatedBy, 120))
      ))
      && (!('bannerAds' in data) || (
        data.bannerAds is list &&
        data.bannerAds.size() <= 15 &&
        (data.bannerAds.size() == 0 || data.bannerAds[0] is map)
      ))
      && (!('coinMiningSettings' in data) || (
        data.coinMiningSettings is map &&
        data.coinMiningSettings.keys().hasAll([
          'paidMiningEnabled', 'tapToMineEnabled', 'tapRewardCoins',
          'tapUsdPerCoin', 'maxEnergy', 'energyCostPerTap',
          'energyRegenPerSec', 'dailyTapLimitCoins'
        ]) &&
        data.coinMiningSettings.keys().hasOnly([
          'paidMiningEnabled', 'tapToMineEnabled', 'tapRewardCoins',
          'tapUsdPerCoin', 'maxEnergy', 'energyCostPerTap',
          'energyRegenPerSec', 'dailyTapLimitCoins'
        ]) &&
        data.coinMiningSettings.paidMiningEnabled is bool &&
        data.coinMiningSettings.tapToMineEnabled is bool &&
        data.coinMiningSettings.tapRewardCoins is number && data.coinMiningSettings.tapRewardCoins >= 0.1 &&
        data.coinMiningSettings.tapUsdPerCoin is number && data.coinMiningSettings.tapUsdPerCoin >= 0 &&
        data.coinMiningSettings.maxEnergy is number && data.coinMiningSettings.maxEnergy >= 10 &&
        data.coinMiningSettings.energyCostPerTap is number && data.coinMiningSettings.energyCostPerTap >= 1 &&
        data.coinMiningSettings.energyRegenPerSec is number && data.coinMiningSettings.energyRegenPerSec >= 0 &&
        data.coinMiningSettings.dailyTapLimitCoins is number && data.coinMiningSettings.dailyTapLimitCoins >= 1
      ))
      && (!('coinMiningPlans' in data) || (
        data.coinMiningPlans is list &&
        data.coinMiningPlans.size() <= 20 &&
        (data.coinMiningPlans.size() == 0 || data.coinMiningPlans[0] is map)
      ))
      && (!('forexConfig' in data) || (
        data.forexConfig is map &&
        data.forexConfig.keys().hasAll(['tradingEnabled', 'copyTradingEnabled', 'accountTiers', 'copyTraders']) &&
        data.forexConfig.keys().hasOnly(['tradingEnabled', 'copyTradingEnabled', 'accountTiers', 'copyTraders']) &&
        data.forexConfig.tradingEnabled is bool &&
        data.forexConfig.copyTradingEnabled is bool &&
        data.forexConfig.accountTiers is list &&
        data.forexConfig.accountTiers.size() >= 1 &&
        data.forexConfig.accountTiers.size() <= 6 &&
        data.forexConfig.accountTiers[0] is map &&
        data.forexConfig.copyTraders is list &&
        data.forexConfig.copyTraders.size() <= 20 &&
        (data.forexConfig.copyTraders.size() == 0 || data.forexConfig.copyTraders[0] is map)
      ))
      && (!('supportAutoResponder' in data) || (
        data.supportAutoResponder is map &&
        data.supportAutoResponder.keys().hasAll([
          'enabled', 'notifyOnStatusChange', 'senderName', 'subjectTemplate',
          'bodyTemplate', 'slaUrgent', 'slaHigh', 'slaMedium', 'slaLow'
        ]) &&
        data.supportAutoResponder.keys().hasOnly([
          'enabled', 'notifyOnStatusChange', 'senderName', 'subjectTemplate',
          'bodyTemplate', 'slaUrgent', 'slaHigh', 'slaMedium', 'slaLow'
        ]) &&
        data.supportAutoResponder.enabled is bool &&
        data.supportAutoResponder.notifyOnStatusChange is bool &&
        isNonEmptyString(data.supportAutoResponder.senderName, 120) &&
        isNonEmptyString(data.supportAutoResponder.subjectTemplate, 200) &&
        isNonEmptyString(data.supportAutoResponder.bodyTemplate, 2000) &&
        isNonEmptyString(data.supportAutoResponder.slaUrgent, 80) &&
        isNonEmptyString(data.supportAutoResponder.slaHigh, 80) &&
        isNonEmptyString(data.supportAutoResponder.slaMedium, 80) &&
        isNonEmptyString(data.supportAutoResponder.slaLow, 80)
      ))
      && (!('kycSettings' in data) || (
        data.kycSettings is map &&
        data.kycSettings.keys().hasAll([
          'enabled', 'requireKycForDeposits', 'requireKycForPackages', 'requireKycForClaims',
          'requireKycForWithdrawals', 'allowFreeAiOcr', 'requireBackSideForCards',
          'requireLiveSelfie', 'activeProvider', 'disabledCountryCodes'
        ]) &&
        data.kycSettings.keys().hasOnly([
          'enabled', 'requireKycForDeposits', 'requireKycForPackages', 'requireKycForClaims',
          'requireKycForWithdrawals', 'allowFreeAiOcr', 'requireBackSideForCards',
          'requireLiveSelfie', 'activeProvider', 'disabledCountryCodes'
        ]) &&
        data.kycSettings.enabled is bool &&
        data.kycSettings.requireKycForDeposits is bool &&
        data.kycSettings.requireKycForPackages is bool &&
        data.kycSettings.requireKycForClaims is bool &&
        data.kycSettings.requireKycForWithdrawals is bool &&
        data.kycSettings.allowFreeAiOcr is bool &&
        data.kycSettings.requireBackSideForCards is bool &&
        data.kycSettings.requireLiveSelfie is bool &&
        data.kycSettings.activeProvider in ['free_qr_mrz_ocr', 'free_ai_ocr', 'didit_free', 'sumsub', 'veriff', 'shufti_pro', 'custom_webhook'] &&
        data.kycSettings.disabledCountryCodes is list &&
        data.kycSettings.disabledCountryCodes.size() <= 250 &&
        (data.kycSettings.disabledCountryCodes.size() == 0 || data.kycSettings.disabledCountryCodes[0] is string)
      ))
      && (!('marketingCardsConfig' in data) || (
        data.marketingCardsConfig is map &&
        data.marketingCardsConfig.keys().hasAll([
          'enabled', 'allowQrCode', 'allowReferralCode', 'allowRankBadge',
          'allowPackageBadge', 'defaultHeadline', 'defaultTagline', 'disclaimerText', 'templates'
        ]) &&
        data.marketingCardsConfig.keys().hasOnly([
          'enabled', 'allowQrCode', 'allowReferralCode', 'allowRankBadge',
          'allowPackageBadge', 'defaultHeadline', 'defaultTagline', 'disclaimerText', 'templates'
        ]) &&
        data.marketingCardsConfig.enabled is bool &&
        data.marketingCardsConfig.allowQrCode is bool &&
        data.marketingCardsConfig.allowReferralCode is bool &&
        data.marketingCardsConfig.allowRankBadge is bool &&
        data.marketingCardsConfig.allowPackageBadge is bool &&
        isBoundedString(data.marketingCardsConfig.defaultHeadline, 140) &&
        isBoundedString(data.marketingCardsConfig.defaultTagline, 240) &&
        isBoundedString(data.marketingCardsConfig.disclaimerText, 300) &&
        data.marketingCardsConfig.templates is list &&
        data.marketingCardsConfig.templates.size() <= 20 &&
        (data.marketingCardsConfig.templates.size() == 0 || data.marketingCardsConfig.templates[0] is map)
      ))
      && (!('howItWorksConfig' in data) || (
        data.howItWorksConfig is map &&
        data.howItWorksConfig.keys().hasAll([
          'enabled', 'showOnHomepage', 'defaultLanguage', 'disclaimerText', 'steps', 'videos'
        ]) &&
        data.howItWorksConfig.keys().hasOnly([
          'enabled', 'showOnHomepage', 'defaultLanguage', 'disclaimerText', 'steps', 'videos'
        ]) &&
        data.howItWorksConfig.enabled is bool &&
        data.howItWorksConfig.showOnHomepage is bool &&
        data.howItWorksConfig.defaultLanguage in ['en', 'hi', 'es'] &&
        isBoundedString(data.howItWorksConfig.disclaimerText, 360) &&
        data.howItWorksConfig.steps is list &&
        data.howItWorksConfig.steps.size() <= 8 &&
        (data.howItWorksConfig.steps.size() == 0 || data.howItWorksConfig.steps[0] is map) &&
        data.howItWorksConfig.videos is list &&
        data.howItWorksConfig.videos.size() <= 10 &&
        (data.howItWorksConfig.videos.size() == 0 || data.howItWorksConfig.videos[0] is map)
      ))
      && (!('leaderboardConfig' in data) || (
        data.leaderboardConfig is map &&
        data.leaderboardConfig.keys().hasAll([
          'enabled', 'title', 'subtitle', 'activeTimeframe', 'maxVisibleRows',
          'showReferralTab', 'showTradersTab', 'allowClientSelfRank', 'disclaimerText', 'entries'
        ]) &&
        data.leaderboardConfig.keys().hasOnly([
          'enabled', 'title', 'subtitle', 'activeTimeframe', 'maxVisibleRows',
          'showReferralTab', 'showTradersTab', 'allowClientSelfRank', 'disclaimerText',
          'lastLiveSyncAtIso', 'entries'
        ]) &&
        data.leaderboardConfig.enabled is bool &&
        isBoundedString(data.leaderboardConfig.title, 120) &&
        isBoundedString(data.leaderboardConfig.subtitle, 220) &&
        data.leaderboardConfig.activeTimeframe in ['weekly', 'monthly', 'all_time'] &&
        data.leaderboardConfig.maxVisibleRows is number &&
        data.leaderboardConfig.maxVisibleRows >= 3 &&
        data.leaderboardConfig.maxVisibleRows <= 25 &&
        data.leaderboardConfig.showReferralTab is bool &&
        data.leaderboardConfig.showTradersTab is bool &&
        data.leaderboardConfig.allowClientSelfRank is bool &&
        isBoundedString(data.leaderboardConfig.disclaimerText, 360) &&
        (!('lastLiveSyncAtIso' in data.leaderboardConfig) || isBoundedString(data.leaderboardConfig.lastLiveSyncAtIso, 64)) &&
        data.leaderboardConfig.entries is list &&
        data.leaderboardConfig.entries.size() <= 40 &&
        (data.leaderboardConfig.entries.size() == 0 || data.leaderboardConfig.entries[0] is map)
      ))
      && (!('web3PaymentConfig' in data) || (
        data.web3PaymentConfig is map &&
        data.web3PaymentConfig.keys().hasAll([
          'autoDepositEnabled', 'bep20Enabled', 'polygonEnabled',
          'bep20ReceivingAddress', 'polygonReceivingAddress', 'trc20ReceivingAddress',
          'minConfirmationsBsc', 'minConfirmationsPolygon',
          'minDepositUsd', 'maxDepositUsd', 'minWithdrawalUsd', 'maxWithdrawalUsd',
          'withdrawalFeePercent', 'withdrawalFlatFeeUsd',
          'require2faForWithdrawals', 'requireKycForWithdrawals', 'requirePayoutTxHashOnApprove'
        ]) &&
        data.web3PaymentConfig.keys().hasOnly([
          'autoDepositEnabled', 'bep20Enabled', 'polygonEnabled',
          'bep20ReceivingAddress', 'polygonReceivingAddress', 'trc20ReceivingAddress',
          'minConfirmationsBsc', 'minConfirmationsPolygon',
          'minDepositUsd', 'maxDepositUsd', 'minWithdrawalUsd', 'maxWithdrawalUsd',
          'withdrawalFeePercent', 'withdrawalFlatFeeUsd',
          'require2faForWithdrawals', 'requireKycForWithdrawals', 'requirePayoutTxHashOnApprove',
          'walletConnectProjectId'
        ]) &&
        data.web3PaymentConfig.autoDepositEnabled is bool &&
        data.web3PaymentConfig.bep20Enabled is bool &&
        data.web3PaymentConfig.polygonEnabled is bool &&
        isBoundedString(data.web3PaymentConfig.bep20ReceivingAddress, 64) &&
        data.web3PaymentConfig.bep20ReceivingAddress.matches('^(0x[a-fA-F0-9]{40})?$') &&
        isBoundedString(data.web3PaymentConfig.polygonReceivingAddress, 64) &&
        data.web3PaymentConfig.polygonReceivingAddress.matches('^(0x[a-fA-F0-9]{40})?$') &&
        isBoundedString(data.web3PaymentConfig.trc20ReceivingAddress, 64) &&
        data.web3PaymentConfig.minConfirmationsBsc is number &&
        data.web3PaymentConfig.minConfirmationsBsc >= 1 && data.web3PaymentConfig.minConfirmationsBsc <= 30 &&
        data.web3PaymentConfig.minConfirmationsPolygon is number &&
        data.web3PaymentConfig.minConfirmationsPolygon >= 1 && data.web3PaymentConfig.minConfirmationsPolygon <= 60 &&
        data.web3PaymentConfig.minDepositUsd is number && data.web3PaymentConfig.minDepositUsd >= 1 &&
        data.web3PaymentConfig.maxDepositUsd is number && data.web3PaymentConfig.maxDepositUsd >= data.web3PaymentConfig.minDepositUsd &&
        data.web3PaymentConfig.minWithdrawalUsd is number && data.web3PaymentConfig.minWithdrawalUsd >= 1 &&
        data.web3PaymentConfig.maxWithdrawalUsd is number && data.web3PaymentConfig.maxWithdrawalUsd >= data.web3PaymentConfig.minWithdrawalUsd &&
        data.web3PaymentConfig.withdrawalFeePercent is number &&
        data.web3PaymentConfig.withdrawalFeePercent >= 0 && data.web3PaymentConfig.withdrawalFeePercent <= 15 &&
        data.web3PaymentConfig.withdrawalFlatFeeUsd is number &&
        data.web3PaymentConfig.withdrawalFlatFeeUsd >= 0 && data.web3PaymentConfig.withdrawalFlatFeeUsd <= 50 &&
        data.web3PaymentConfig.require2faForWithdrawals is bool &&
        data.web3PaymentConfig.requireKycForWithdrawals is bool &&
        data.web3PaymentConfig.requirePayoutTxHashOnApprove is bool &&
        (!('walletConnectProjectId' in data.web3PaymentConfig) || isBoundedString(data.web3PaymentConfig.walletConnectProjectId, 80))
      ))
      && data.pumpFunToken is map
      && data.updatedAt == request.time;
    }

    function isValidMarketingCardStats(data) {
      return data.keys().hasAll(['totalGenerated', 'totalShared', 'updatedAt'])
        && data.keys().hasOnly(['totalGenerated', 'totalShared', 'updatedAt'])
        && data.totalGenerated is int && data.totalGenerated >= 0
        && data.totalShared is int && data.totalShared >= 0
        && data.updatedAt == request.time;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'email', 'fullName', 'handle', 'role', 'referredByUid',
        'referredByHandle', 'uplineChain', 'kycStatus', 'idType', 'idNumber',
        'idPhotoData', 'portraitPhotoData', 'usdBalance', 'profitBalance',
        'totalInvested', 'totalWithdrawn', 'isMentor', 'mentorGiftedCapital',
        'mentorRequiredVolume', 'mentorBroughtVolume', 'createdAt', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'email', 'fullName', 'handle', 'role', 'referredByUid',
        'referredByHandle', 'uplineChain', 'kycStatus', 'idType', 'idNumber',
        'idPhotoData', 'idBackPhotoData', 'portraitPhotoData', 'avatarData',
        'kycCountryCode', 'kycCountryName', 'kycDateOfBirth', 'kycNationality',
        'kycIssueDate', 'kycExpiryDate', 'kycAddress', 'kycRejectionReason',
        'kycResubmissionRequested', 'kycVerificationMethod', 'kycApiVerificationStatus',
        'kycOcrConfidence', 'kycLivenessPassed', 'kycSubmittedAtMs',
        'kycReviewedAtMs', 'kycReviewedBy',
        'countryCode', 'countryName', 'phoneDialPrefix', 'phoneNumber', 'phoneVerified',
        'whitelistStrictMode', 'whitelist24hLockEnabled',
        'suspended', 'suspensionReason',
        'usdBalance', 'profitBalance',
        'totalInvested', 'totalWithdrawn', 'isMentor', 'mentorGiftedCapital',
        'mentorRequiredVolume', 'mentorBroughtVolume', 'createdAt', 'updatedAt'
      ])
      && isValidId(data.uid) && data.uid == userId
      && isNonEmptyString(data.email, 254)
      && isNonEmptyString(data.fullName, 120)
      && isValidId(data.handle) && data.handle.size() <= 32
      && data.role in ['user', 'admin']
      && isBoundedString(data.referredByUid, 128)
      && isBoundedString(data.referredByHandle, 32)
      && data.uplineChain is list && data.uplineChain.size() <= 3
      && (data.uplineChain.size() == 0 || data.uplineChain[0] is string)
      && data.kycStatus in ['unsubmitted', 'pending', 'approved', 'rejected']
      && data.idType in ['NID', 'Passport', 'Driving License', '']
      && isBoundedString(data.idNumber, 64)
      && isBoundedString(data.idPhotoData, 300000)
      && (!('idBackPhotoData' in data) || isBoundedString(data.idBackPhotoData, 300000))
      && isBoundedString(data.portraitPhotoData, 300000)
      && (!('avatarData' in data) || isBoundedString(data.avatarData, 300000))
      && (!('kycCountryCode' in data) || (isBoundedString(data.kycCountryCode, 8) && data.kycCountryCode.matches('^([A-Z]{2,4})?$')))
      && (!('kycCountryName' in data) || isBoundedString(data.kycCountryName, 80))
      && (!('kycDateOfBirth' in data) || isBoundedString(data.kycDateOfBirth, 32))
      && (!('kycNationality' in data) || isBoundedString(data.kycNationality, 80))
      && (!('kycIssueDate' in data) || isBoundedString(data.kycIssueDate, 32))
      && (!('kycExpiryDate' in data) || isBoundedString(data.kycExpiryDate, 32))
      && (!('kycAddress' in data) || isBoundedString(data.kycAddress, 260))
      && (!('kycRejectionReason' in data) || isBoundedString(data.kycRejectionReason, 400))
      && (!('kycResubmissionRequested' in data) || data.kycResubmissionRequested is bool)
      && (!('kycVerificationMethod' in data) || isBoundedString(data.kycVerificationMethod, 80))
      && (!('kycApiVerificationStatus' in data) || data.kycApiVerificationStatus in ['none', 'ocr_preview_only', 'manual_review', 'live_api_pending', 'live_api_verified'])
      && (!('kycOcrConfidence' in data) || (data.kycOcrConfidence is number && data.kycOcrConfidence >= 0 && data.kycOcrConfidence <= 100))
      && (!('kycLivenessPassed' in data) || data.kycLivenessPassed is bool)
      && (!('kycSubmittedAtMs' in data) || (data.kycSubmittedAtMs is number && data.kycSubmittedAtMs >= 0))
      && (!('kycReviewedAtMs' in data) || (data.kycReviewedAtMs is number && data.kycReviewedAtMs >= 0))
      && (!('kycReviewedBy' in data) || isBoundedString(data.kycReviewedBy, 120))
      && (!('countryCode' in data) || (isBoundedString(data.countryCode, 8) && data.countryCode.matches('^([A-Z]{2,4})?$')))
      && (!('countryName' in data) || isBoundedString(data.countryName, 80))
      && (!('phoneDialPrefix' in data) || (isBoundedString(data.phoneDialPrefix, 12) && data.phoneDialPrefix.matches('^(\\+[0-9]{1,8})?$')))
      && (!('phoneNumber' in data) || (isBoundedString(data.phoneNumber, 24) && data.phoneNumber.matches('^(\\+[0-9]{6,18})?$')))
      && (!('phoneVerified' in data) || data.phoneVerified is bool)
      && (!('whitelistStrictMode' in data) || data.whitelistStrictMode is bool)
      && (!('whitelist24hLockEnabled' in data) || data.whitelist24hLockEnabled is bool)
      && (!('suspended' in data) || data.suspended is bool)
      && (!('suspensionReason' in data) || isBoundedString(data.suspensionReason, 300))
      && data.usdBalance is number && data.usdBalance >= 0
      && data.profitBalance is number && data.profitBalance >= 0
      && data.totalInvested is number && data.totalInvested >= 0
      && data.totalWithdrawn is number && data.totalWithdrawn >= 0
      && data.isMentor is bool
